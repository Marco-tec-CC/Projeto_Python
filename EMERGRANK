class Paciente:
    def __init__(self, nome, idade, gravidade):
        self.nome = nome
        self.idade = idade
        self.gravidade = gravidade

    def __repr__(self):
        return f'{self.nome} (Idade: {self.idade}, Gravidade: {self.gravidade})'

prioridades = {
    'vermelho': 1,
    'laranja': 2,
    'amarelo': 3,
    'verde': 4
}

def obter_gravidade():
    while True:
        gravidade = input("Digite a gravidade (vermelho, amarelo, verde ou azul): ").strip().lower()
        if gravidade in prioridades:
            return gravidade
        print("Gravidade inválida. Tente novamente.")

def adicionar_pacientes():
    pacientes = []
    while True:
        nome = input("Nome do paciente: ").strip()
        idade = input("Idade do paciente: ").strip()
        gravidade = obter_gravidade()

        paciente = Paciente(nome, idade, gravidade)
        pacientes.append(paciente)

        continuar = input("Deseja adicionar outro paciente? (s/n): ").strip().lower()
        if continuar != 's':
            break
    return pacientes

def exibir_fila(pacientes):
    pacientes_ordenados = sorted(pacientes, key=lambda p: prioridades[p.gravidade])
    print("\n📋 Fila de Atendimento Prioritária:\n")
    for i, p in enumerate(pacientes_ordenados, start=1):
        print(f"{i}. {p}")

from fila import adicionar_pacientes, exibir_fila

def main():
    print("=== Sistema de Fila Hospitalar ===")
    pacientes = adicionar_pacientes()
    exibir_fila(pacientes)

if __name__ == "__main__":
    main()
